# ===========================================================================
# MeetingMind — Root Environment Variables
#
# Copy to .env and replace all <generated> placeholders with real values.
# Production startup MUST reject placeholder secrets.
#
# Generate secrets: openssl rand -base64 32
# ===========================================================================

# --- Environment ---
MEETINGMIND_ENV=development
MEETINGMIND_DEBUG=true

# --- PostgreSQL ---
POSTGRES_DB=meetingmind
POSTGRES_USER=meetingmind
POSTGRES_PASSWORD=<generated-high-entropy-value>

# --- Application ---
MEETINGMIND_API_V1_PREFIX=/api/v1
MEETINGMIND_CORS_ORIGINS=http://localhost:3000,http://localhost,chrome-extension://*
MEETINGMIND_FRONTEND_URL=http://localhost:3000
MEETINGMIND_API_WORKERS=2

# --- JWT / Auth ---
MEETINGMIND_JWT_SECRET=<generated-high-entropy-value>
MEETINGMIND_ACCESS_TOKEN_MINUTES=15
MEETINGMIND_REFRESH_TOKEN_DAYS=7

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=<generated>
MINIO_ROOT_PASSWORD=<generated-high-entropy-value>
MEETINGMIND_STORAGE_ENDPOINT=http://minio:9000
MEETINGMIND_STORAGE_BUCKET=meetingmind

# --- Redis ---
MEETINGMIND_REDIS_URL=redis://redis:6379/0

# --- Worker ---
MEETINGMIND_WORKER_CONCURRENCY=2

# --- Nginx ---
MEETINGMIND_HTTP_PORT=80
# MEETINGMIND_HTTPS_PORT=443

# --- Password Reset (disabled by default) ---
MEETINGMIND_PASSWORD_RESET_NOTIFIER=disabled
# MEETINGMIND_SMTP_HOST=
# MEETINGMIND_SMTP_PORT=587
# MEETINGMIND_SMTP_STARTTLS=true
# MEETINGMIND_SMTP_USERNAME=
# MEETINGMIND_SMTP_PASSWORD=
# MEETINGMIND_SMTP_FROM_EMAIL=

# --- External AI (disabled by default — local Ollama is used) ---
EXTERNAL_AI_ENABLED=false
# OPENAI_API_KEY=

# --- Telemetry (disabled by default) ---
TELEMETRY_ENABLED=false
