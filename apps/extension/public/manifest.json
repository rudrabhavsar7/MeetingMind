{
  "manifest_version": 3,
  "name": "MeetingMind Capture",
  "description": "Capture meetings and stream audio to MeetingMind.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "MeetingMind"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["assets/content.js"]
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "tabCapture",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*"
  ]
}
